# Salin menjadi agent.env di folder yang sama dengan apmagent.exe (PC kiosk).

# Sama dengan KIOSK_AGENT_TOKEN di .env server APM (acak, >=16 karakter)
AGENT_TOKEN=
AGENT_LISTEN=:8099
# IP server APM yang boleh memanggil agent (pisahkan koma). Kosong = semua IP (tidak disarankan).
AGENT_IZIN_IP=

# ===== Aplikasi Sidik Jari BPJS =====
# Path exe di PC kiosk (sama dengan URLAPLIKASIFINGERPRINT di database.xml Khanza)
FINGERPRINT_EXE=
# Isi potongan judul jendela bila exe hanya launcher (jendela muncul dari proses lain)
FINGERPRINT_JUDUL=
# Akun aplikasi sidik jari (sama dengan USERFINGER/PASSFINGER Khanza). Hanya disimpan di PC kiosk.
FINGERPRINT_USER=
FINGERPRINT_PASS=
# Urutan langkah, dipisah ";". tunggu:ms | ketik:teks | tab | enter | fokus
# Placeholder: {NOKA} {NIK} {USER} {PASS}. Sesuaikan dengan layar aplikasi versi RS.
FINGERPRINT_LANGKAH=tunggu:1500;ketik:{USER};tab;ketik:{PASS};enter;tunggu:1500;ketik:{NOKA}

# ===== Aplikasi Frista (verifikasi wajah) =====
FRISTA_EXE=
FRISTA_JUDUL=
FRISTA_USER=
FRISTA_PASS=
# Contoh saja; urutan login Frista belum dipastikan. Uji dulu dan sesuaikan.
FRISTA_LANGKAH=tunggu:3000;ketik:{USER};tab;ketik:{PASS};enter;tunggu:3000;ketik:{NOKA}
