# ===== Aplikasi =====
APP_PORT=8088
APP_KIOSK_ID=APM-01
APP_USER_SEP=APM            # diisi ke bridging_sep.user dan t_sep.user
APP_IDLE_DETIK=60           # tanpa sentuhan → kembali ke beranda
APP_SELESAI_DETIK=15        # layar selesai → otomatis kembali

# ===== Database Khanza (sik) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sik
DB_USER=
DB_PASS=

# ===== BPJS (hanya di server, JANGAN di PC kiosk) =====
# Development: https://apijkn-dev.bpjs-kesehatan.go.id/vclaim-rest-dev  dan  .../antreanrs_dev
BPJS_VCLAIM_URL=https://apijkn.bpjs-kesehatan.go.id/vclaim-rest
BPJS_ANTREAN_URL=https://apijkn.bpjs-kesehatan.go.id/antreanrs
BPJS_CONS_ID=
BPJS_SECRET=
BPJS_USER_KEY_VCLAIM=
BPJS_USER_KEY_ANTREAN=
# Isi bila cons id / secret antrean berbeda dari VClaim (CONSIDAPIMOBILEJKN di Khanza)
BPJS_ANTREAN_CONS_ID=
BPJS_ANTREAN_SECRET=
BPJS_TIMEOUT_SEC=20
BPJS_KIRIM_ANTREAN=yes      # sama dengan ADDANTRIANAPIMOBILEJKN Khanza
BPJS_KIRIM_TASK3=yes        # no = biarkan KhanzaHMSServiceMobileJKN yang kirim task 3 (dari mutasi_berkas)
ANTREAN_MENIT_PER_PASIEN=5  # Khanza: estimasi = jam_mulai + no_reg × 5 menit

# ===== Aturan Khanza (samakan dengan setting/database.xml Khanza RS) =====
KHANZA_KD_PJ_BPJS=BPJ
KHANZA_URUT_NOREG=dokter + poli   # dokter | poli | dokter + poli   (URUTNOREG)
KHANZA_BASE_NOREG=booking         # registrasi | booking            (BASENOREG)
# kosong = setting.kode_ppk
KHANZA_KD_PPK=

# ===== SEP =====
SEP_CATATAN=Pendaftaran APM
SEP_KONTROL_TUJUANKUNJ=2          # 2 = Konsul Dokter
SEP_KONTROL_ASESMEN=5             # 5 = Tujuan Kontrol (pola jenis kunjungan 3 di Khanza)
RUJUKAN_BERLAKU_HARI=90
FINGERPRINT_MODE=poli             # off | poli | semua
# kd_poli_bpjs wajib biometrik bila mode=poli, contoh: IRM,HDL
FINGERPRINT_POLI_WAJIB=

# ===== Tombol "Buka Sidik Jari / Frista" (butuh apmagent.exe di PC kiosk) =====
# Kosong = tombol tidak tampil. Isi token acak >=16 karakter, sama dengan AGENT_TOKEN di agent.env.
KIOSK_AGENT_TOKEN=
# Kosong = http://<IP PC kiosk yang membuka APM>:KIOSK_AGENT_PORT
KIOSK_AGENT_URL=
KIOSK_AGENT_PORT=8099
KIOSK_TOMBOL_FINGERPRINT=yes
KIOSK_TOMBOL_FRISTA=yes
# Lama layar APM tidak kembali ke beranda setelah aplikasi BPJS dibuka (detik)
BIOMETRIK_TAHAN_DETIK=180

# ===== Printer thermal 80mm (ESC/POS) =====
PRINTER_MODE=tcp                  # tcp | windows-share | file | off
PRINTER_ADDR=192.168.1.50:9100    # windows-share: \\PC-KIOSK01\EPSON-TM ; file: cetak.bin
# browser = SEP format Khanza (rptBridgingSEP2) ke printer default PC kiosk; escpos = ke printer thermal; off
PRINTER_SEP=browser
